# nginx template: the image's entrypoint fills in ${OMADA_CONTROLLER_URL} and
# ${TERMINAL_GATEWAY_URL} from the container's environment at startup and
# writes the result to /etc/nginx/conf.d/default.conf. Only variables that
# are set are replaced, so nginx's own $variables are left alone. Defaults
# (web/Dockerfile) match the bundled docker-compose.yml; set them to point
# the UI at a controller somewhere else, e.g. https://192.168.1.10:8043.
# Plain HTTP only sends the browser to HTTPS. WEB_UI_HTTPS_PORT is the host
# port mapped to the container's 443 (default 8443).
server {
    listen 80;
    server_name _;
    return 301 https://$host:${WEB_UI_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    # Self-signed unless you mount your own (tls-cert.sh).
    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse proxy to the Omada controller. Solves CORS and self-signed
    # cert trust: the browser only ever talks to this origin over http.
    # The address is resolved once at startup, so a hostname must resolve
    # then (an IP address always works).
    location /controller-api/ {
        proxy_pass ${OMADA_CONTROLLER_URL}/;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host omada.local;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        # Backup restore uploads a .cfg of up to 500 MB and the controller
        # answers only once it has taken the file in (vendor timeout: 20 min).
        # nginx would otherwise reject anything over 1 MB with 413.
        client_max_body_size 500m;
        proxy_send_timeout 20m;
        # The controller's session cookie (TPOMADA_SESSIONID, Path=/, Secure)
        # is moved to Path=/controller-api/. The vendor UI on the same host
        # (https://<nas>:8043) keeps its own at Path=/; browsers key cookies
        # by name + host + path and ignore ports, so with one path the two
        # UIs overwrote each other's session ("Your session has ended").
        # Our requests list ours first (longer path first) and the
        # controller reads the first one. Secure stays: we serve HTTPS.
        proxy_cookie_path / /controller-api/;
        proxy_cookie_flags TPOMADA_SESSIONID samesite=lax;
        # A dead session gets a 302 to https://omada.local/…/login. Browsers
        # follow redirects on their own (axios maxRedirects is Node-only), so
        # the app only saw a network error and pages hung. Answer 401 instead;
        # the client then signs the user out. Other statuses pass through.
        proxy_intercept_errors on;
        error_page 302 = @controller_signed_out;
    }

    # The restore upload itself: same proxy, longer read timeout.
    location ~ ^/controller-api/[^/]+/api/v2/(anon/)?files/(qs/)?restore$ {
        # Strip the prefix here; proxy_pass without a path then keeps the
        # rewritten URI and query string, with no runtime DNS lookup.
        rewrite ^/controller-api/(.*)$ /$1 break;
        proxy_pass ${OMADA_CONTROLLER_URL};
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host omada.local;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /controller-api/;
        proxy_cookie_flags TPOMADA_SESSIONID samesite=lax;
        client_max_body_size 500m;
        proxy_send_timeout 20m;
        proxy_read_timeout 20m;
        proxy_intercept_errors on;
        error_page 302 = @controller_signed_out;
    }

    location @controller_signed_out {
        default_type application/json;
        return 401 '{"errorCode":-1200,"msg":"Your session has ended. Please sign in again."}';
    }

    # Device terminal: WebSocket to the terminal gateway (web/terminal/), which
    # bridges to SSH. Origin and Host must match there, so pass Host through.
    location = /terminal/ws {
        # Resolve at request time (Docker DNS), so nginx still starts when the
        # gateway container is missing — the terminal just reports an error.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $terminal_gateway ${TERMINAL_GATEWAY_URL};
        proxy_pass $terminal_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache hashed build assets aggressively; never cache index.html
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
